{
  "name": "homa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @homa/server --filter @homa/web dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun --filter '*' test",
    "openapi": "bun --filter @homa/api-client generate",
    "build": "bun --filter @homa/web build",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  }
}
