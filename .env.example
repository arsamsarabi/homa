# Postgres connection string.
DATABASE_URL=postgres://homa:homa@localhost:5432/homa
# Signs sessions and tokens. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address people use to reach this instance. In development that's the Vite server;
# the API only accepts sign-ins from this origin.
HOMA_URL=http://localhost:5173
PORT=3000
# api (HTTP only), worker (background jobs only) or all (both).
HOMA_ROLE=all
