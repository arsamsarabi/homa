# Postgres connection string. For `bun run dev:app` (API/web on the host) against compose deps:
DATABASE_URL=postgres://homa:homa@127.0.0.1:55434/homa
# `bun run dev` runs the app in Compose and overrides this to postgres://…@postgres:5432/homa.
# Signs sessions and tokens. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address people use to reach this instance. In development that's the Vite server;
# the API only accepts sign-ins from this origin.
HOMA_URL=http://localhost:5180
PORT=3000
# api (HTTP only), worker (background jobs only) or all (both).
HOMA_ROLE=all

# Optional. Pins the 4-digit first-run setup code (normally random and printed in the log at
# start). For automated tests only; leave unset in production.
# HOMA_SETUP_CODE=

# Encrypts connected calendars' saved details (feed URLs, which can hold private tokens) at rest.
# 32 bytes, base64: openssl rand -base64 32. Optional until someone adds a connected calendar;
# after that the server won't start without it, and changing it means re-adding every connection.
# HOMA_ENCRYPTION_KEY=
# How often each connected calendar is synced, in minutes (5 to 1440).
# HOMA_SYNC_INTERVAL_MINUTES=30
# Allow subscribing to feeds on loopback and private networks (a calendar server on your LAN).
# Off by default so a feed URL can't reach the server's own network.
# HOMA_SYNC_ALLOW_PRIVATE_NETWORKS=false
# Web push (VAPID) keys for reminders, as `bunx web-push generate-vapid-keys` prints them. Set both
# or neither; without them the server generates a pair on first start and keeps it in the database.
# HOMA_VAPID_PUBLIC_KEY=
# HOMA_VAPID_PRIVATE_KEY=
# Who push services can contact about this server: mailto: or https:. Defaults to HOMA_URL when it is
# https, else mailto:admin@localhost (Apple refuses that one, so set it for Safari and iOS).
# HOMA_VAPID_SUBJECT=
# Allow notification endpoints (push services; ntfy, Gotify and webhooks) on loopback and private
# networks, and over plain http. Off by default so a user-supplied address can't reach the server's
# own network.
# HOMA_NOTIFY_ALLOW_PRIVATE_NETWORKS=false
# Email (reminders, address confirmation and password reset links): your SMTP server,
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465, and the sender. Set both or
# neither; without them email isn't offered and nobody can reset a forgotten password by email.
# Local Mailpit: UI at http://127.0.0.1:8025. Needed for `bun run dev:app` on the host;
# `bun run dev` sets these inside Compose automatically.
# HOMA_SMTP_URL=smtp://127.0.0.1:1025
# HOMA_MAIL_FROM=Homa <homa@localhost>
# New accounts confirm their email address before they can sign in. Defaults to true when email is
# set up and false otherwise; true without email stops the server at startup.
# HOMA_REQUIRE_EMAIL_VERIFICATION=
# Your Google OAuth client, to let people connect Google Calendar (see docs/self-hosting/google.md).
# Set both or neither. Its redirect URI must be ${HOMA_URL}/api/connections/google/callback.
# HOMA_GOOGLE_CLIENT_ID=
# HOMA_GOOGLE_CLIENT_SECRET=
# Your Microsoft Entra ID app, to let people connect Outlook.com and Microsoft 365 calendars (see
# docs/self-hosting/microsoft.md). Set both or neither. Its redirect URI must be
# ${HOMA_URL}/api/connections/microsoft/callback.
# HOMA_MICROSOFT_CLIENT_ID=
# HOMA_MICROSOFT_CLIENT_SECRET=
# Only for automated tests: false lifts the sign-in and sign-up rate limits.
# HOMA_AUTH_RATE_LIMIT=true

# One OIDC provider for sign-in (see docs/self-hosting/sign-in.md). Set all three or none. The
# redirect URI to register is ${HOMA_URL}/api/auth/callback/oidc. Optional button label (default SSO).
# HOMA_OIDC_ISSUER=
# HOMA_OIDC_CLIENT_ID=
# HOMA_OIDC_CLIENT_SECRET=
# HOMA_OIDC_NAME=SSO
# A public demo: seeds a shared account and blocks everything that sends anything out. Reset it
# nightly with `bun apps/server/src/demo-reset.ts`. See docs/self-hosting/demo.md. Not for normal use.
# HOMA_DEMO=false
